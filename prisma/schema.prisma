generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  curp        String   @unique
  full_name   String
  is_new_user Boolean  @default(true)
  created_at  DateTime @default(now())

  tickets Ticket[]
  orders  Order[]

  @@map("tik_users")
}

model EventType {
  id     String  @id @default(uuid())
  name   String
  events Event[]

  @@map("tik_event_types")
}

model Event {
  id                  String    @id @default(uuid())
  name                String
  description         String
  date                DateTime
  location            String
  capacity            Int
  price               Float

  tmdb_id             Int?
  poster_url          String?
  backdrop_url        String?
  vote_average        Float?
  classification      String?
  restrictions        String[]
  dress_code          String?
  max_per_user        Int?
  access_restrictions String?

  eventTypeId String    @map("event_type_id")
  eventType   EventType @relation(fields: [eventTypeId], references: [id])

  showtimes Showtime[]
  tickets   Ticket[]

  @@map("tik_events")
}

model Showtime {
  id             String      @id @default(uuid())
  datetime       DateTime
  venue_name     String
  venue_address  String
  lat            Float?
  lng            Float?
  price          Float
  available_seats Int
  service_type   ServiceType @default(TRADITIONAL)

  eventId  String @map("event_id")
  event    Event  @relation(fields: [eventId], references: [id])

  seats   Seat[]
  orders  Order[]
  tickets Ticket[]

  @@map("tik_showtimes")
}

model Seat {
  id      String     @id @default(uuid())
  label   String
  row     String
  number  Int
  status  SeatStatus @default(AVAILABLE)
  section String?
  price   Float?

  showtimeId String   @map("showtime_id")
  showtime   Showtime @relation(fields: [showtimeId], references: [id])

  orderSeats OrderSeat[]
  ticket     Ticket?

  @@map("tik_seats")
}

model Order {
  id         String      @id @default(uuid())
  total      Float
  expires_at DateTime
  status     OrderStatus @default(PENDING)
  created_at DateTime    @default(now())

  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])

  showtimeId String   @map("showtime_id")
  showtime   Showtime @relation(fields: [showtimeId], references: [id])

  seats         OrderSeat[]
  tickets       Ticket[]
  paymentMethod PaymentMethod?

  @@map("tik_orders")
}

model OrderSeat {
  id      String @id @default(uuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])
  seatId  String @map("seat_id")
  seat    Seat   @relation(fields: [seatId], references: [id])

  @@unique([orderId, seatId])
  @@map("tik_order_seats")
}

model Ticket {
  id         String       @id @default(uuid())
  folio      String       @unique
  price_paid Float
  status     TicketStatus @default(PAID)
  qr_code    String?
  created_at DateTime     @default(now())

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id])

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  showtimeId String?   @map("showtime_id")
  showtime   Showtime? @relation(fields: [showtimeId], references: [id])

  seatId String? @unique @map("seat_id")
  seat   Seat?   @relation(fields: [seatId], references: [id])

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id])

  @@map("tik_tickets")
}

model PaymentMethod {
  id           String      @id @default(uuid())
  type         PaymentType
  card_number  String?
  cardholder   String?
  paypal_email String?
  whatsapp_phone String?

  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  @@map("tik_payment_methods")
}

model Holiday {
  id      String   @id @default(uuid())
  date    DateTime
  name    String
  country String

  @@map("tik_holidays")
}

enum TicketStatus {
  PAID
  USED
  REFUNDED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  TAKEN
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum ServiceType {
  TRADITIONAL
  VIP
  IMAX
  FOUR_DX  @map("4DX")
  MACRO_XE
  PLUUS
  JUNIOR
  VR
  SCREEN_X
}

enum PaymentType {
  DEBIT
  CREDIT
  PAYPAL
}
