{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    
    // Cambios principales aquí:
    "module": "NodeNext",          // Permite top-level await y busca módulos estilo Node moderno
    "moduleResolution": "NodeNext", // Obligatorio si usas NodeNext en 'module'
    "target": "ES2022",            // Ya lo tenías bien, es compatible
    
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}